[Desktop Entry]
Type=Application
Name=UU 远程 Linux
Name[en]=UU Remote Linux
GenericName=Remote assistance host and viewer
Comment=非官方 UU 远程：本机被控（主机）与远程控制端
Comment[en]=Unofficial NetEase UU Remote: this host (remote assistance) and the viewer
Exec=uu-remote
Icon=uu-remote-linux
Terminal=false
Categories=Network;RemoteAccess;
Keywords=remote;assist;viewer;UU;远程;协助;控制;
StartupNotify=false
# Matches the GTK window class so docks/taskbars show this icon for the host window (#13).
StartupWMClass=uu-remote-linux
