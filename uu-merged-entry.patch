+// 被控端和控制端合并成一个入口：主机窗口里直接拉起同目录的控制端。
+static void spawn_viewer(void) {
+    char exe[4096];
+    ssize_t n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (n <= 0) return;
+    exe[n] = '\0';
+    char *slash = strrchr(exe, '/');
+    if (!slash) return;
+    *slash = '\0';
+    char *cmd = g_strdup_printf("%s/uuremote-viewer ui", exe);
+    g_spawn_command_line_async(cmd, NULL);
+    g_free(cmd);
+}
+
+static void on_open_viewer(GtkButton *b, gpointer d) {
+    (void)b; (void)d;
+    spawn_viewer();
+}
